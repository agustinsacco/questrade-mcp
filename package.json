{
  "name": "questrade-mcp",
  "version": "2.0.0",
  "description": "Read-only MCP server for Questrade: accounts, balances, positions, activities, orders, quotes, option chains, candles, technicals and portfolio reports, with context-safe pagination. Also a pi package (server + skill).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "questrade",
    "investing",
    "brokerage",
    "portfolio",
    "pi-package"
  ],
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "questrade-mcp": "bin/questrade-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "credentials.env.example"
  ],
  "pi": {
    "extensions": [
      "./extensions/questrade.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/questrade-mcp.js",
    "start:http": "node bin/questrade-mcp.js serve --http",
    "check": "node bin/questrade-mcp.js check",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node bin/questrade-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agustinsacco/questrade-mcp.git"
  },
  "homepage": "https://github.com/agustinsacco/questrade-mcp#readme",
  "bugs": {
    "url": "https://github.com/agustinsacco/questrade-mcp/issues"
  },
  "author": "Agustin Sacco",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "asciichart": "^1.5.25",
    "technicalindicators": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
