# Copy to ~/.config/questrade-mcp/credentials.env and chmod 600. Never commit it.
# Simplest: run "node bin/questrade-mcp.js login" and paste a token generated in
# Questrade's API Centre; it fills in the keys below for you.

# Refresh token (written by "questrade-mcp login"; rotated on every refresh)
QUESTRADE_REFRESH_TOKEN=

# Written by the server (do not edit): current access token, its expiry and API server
# QUESTRADE_ACCESS_TOKEN=
# QUESTRADE_ACCESS_TOKEN_EXPIRES_AT=
# QUESTRADE_API_SERVER=

# Optional: default account (see: node bin/questrade-mcp.js check)
# QUESTRADE_ACCOUNT_ID=

# Optional: bearer token for the HTTP transport (openssl rand -hex 32)
# QUESTRADE_MCP_HTTP_TOKEN=
